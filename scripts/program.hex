00000020 // add $0, $0, $0 # zero value
00002020 // add $4, $0, $0 # memory pointer
20010005 // addi $1, $0, 5 # store 5 in register 1
2002003C // addi $2, $0, 60 # store 60 in register 2
00221820 // add $3, $1, $2 # register 3 = $1+$2
00412822 // sub $5, $2, $1 # register 5 = $2-$1
AC830000 // sw $3, 0($4) # save register 3 in data memory
20840004 // addi $4, $4, 4
AC850000 // sw $5, 0($4) # save register 5 in data memory
0065382A // slt $7, $3, $5
00A3402A // slt $8, $5, $3
AC870000 // sw $7, 0($4)
20840004 // addi $4, $4, 4
AC880000 // sw $8, 0($4)
20840004 // addi $4, $4, 4
2084FFF4 // addi $4,$4, -12
8C860000 // lw $6, 0($4) # read from data memory to register 6
20C6001E // addi $6,$6,30 # add 30 to saved data
AC860000 // sw $6, 0($4) # store result
1000FFFF // beq $0, $0, -1 # end
